<% content_for :title, "Géneros" %>

<header class="page-head">
  <div>
    <h1>Géneros</h1>
    <p>Solo se puede borrar un género que no tenga canciones.</p>
  </div>
  <div class="page-actions">
    <%= link_to "Nuevo género", new_admin_genre_path, class: "btn-primary" %>
  </div>
</header>

<% if @genres.empty? %>
  <p class="empty">Todavía no hay géneros.</p>
<% else %>
  <div class="table-wrap">
    <table class="ruled" style="max-width: 640px;">
      <thead><tr><th>Género</th><th>Canciones</th><th><span class="sr-only">Acciones</span></th></tr></thead>
      <tbody>
        <% @genres.each do |genre| %>
          <tr>
            <td class="title"><%= link_to genre.name, edit_admin_genre_path(genre) %></td>
            <td class="num"><%= genre.songs.size %></td>
            <td>
              <div class="actions">
                <%= link_to "Editar", edit_admin_genre_path(genre), class: "btn-link" %>
                <%= delete_button admin_genre_path(genre), confirm: "¿Borrar el género #{genre.name}?" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
