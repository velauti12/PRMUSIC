# Copiá este archivo como .env y completalo. El .env no se sube a git.

# Mails de bienvenida. Con Gmail: SMTP_ADDRESS=smtp.gmail.com, SMTP_PORT=587,
# SMTP_USERNAME=tu mail y SMTP_PASSWORD una "contraseña de aplicación" de Google.
# Si lo dejás vacío, los mails no salen y se ven en http://localhost:3000/letter_opener
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# URL del front (para CORS y para el link del mail)
FRONTEND_URL=http://localhost:5173

# Usuario y contraseña del back-office
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
