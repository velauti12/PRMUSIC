<% content_for :title, "Álbumes" %>

<header class="page-head">
  <div>
    <h1>Álbumes</h1>
    <p>La tapa se muestra en el sitio. Al crear o editar un álbum podés buscarla en Deezer con el nombre o subirla a mano.</p>
  </div>
  <div class="page-actions">
    <%= link_to "Nuevo álbum", new_admin_album_path, class: "btn-primary" %>
  </div>
</header>

<% if @albums.empty? %>
  <p class="empty">Todavía no hay álbumes cargados.</p>
<% else %>
  <div class="table-wrap">
    <table class="ruled">
      <thead><tr><th><span class="sr-only">Portada</span></th><th>Álbum</th><th>Artista</th><th>Canciones</th><th><span class="sr-only">Acciones</span></th></tr></thead>
      <tbody>
        <% @albums.each do |album| %>
          <tr>
            <td class="cover">
              <% if album.cover.attached? %>
                <%= image_tag album.cover, alt: "Portada de #{album.title}" %>
              <% else %>
                <span class="cover-empty" title="Sin portada"></span>
              <% end %>
            </td>
            <td class="title"><%= link_to album.title, edit_admin_album_path(album) %></td>
            <td><%= album.artist.name %></td>
            <td class="num"><%= album.songs.size %></td>
            <td>
              <div class="actions">
                <%= link_to album.cover.attached? ? "Editar" : "Buscar tapa", edit_admin_album_path(album), class: album.cover.attached? ? "btn-link" : "btn btn-sm" %>
                <%= delete_button admin_album_path(album), confirm: "¿Borrar el álbum #{album.title}? Sus canciones quedan sin álbum." %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
