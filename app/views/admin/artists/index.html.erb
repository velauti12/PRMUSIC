<% content_for :title, "Artistas" %>

<header class="page-head">
  <div>
    <h1>Artistas</h1>
    <p>Si borrás un artista se borran también sus álbumes y canciones.</p>
  </div>
  <div class="page-actions">
    <%= link_to "Nuevo artista", new_admin_artist_path, class: "btn-primary" %>
  </div>
</header>

<% if @artists.empty? %>
  <p class="empty">Todavía no hay artistas.</p>
<% else %>
  <div class="table-wrap">
    <table class="ruled">
      <thead><tr><th>Artista</th><th>Reseña</th><th>Canciones</th><th><span class="sr-only">Acciones</span></th></tr></thead>
      <tbody>
        <% @artists.each do |artist| %>
          <tr>
            <td class="title"><%= link_to artist.name, edit_admin_artist_path(artist) %></td>
            <td class="muted small"><%= truncate(artist.bio, length: 90) %></td>
            <td class="num"><%= artist.songs.size %></td>
            <td>
              <div class="actions">
                <%= link_to "Editar", edit_admin_artist_path(artist), class: "btn-link" %>
                <%= delete_button admin_artist_path(artist),
                      confirm: "¿Borrar a #{artist.name}? Se borran también sus #{artist.songs.size} canciones y sus álbumes." %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
