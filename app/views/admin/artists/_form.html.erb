<%= form_with model: [:admin, @artist], local: true, class: "form" do |f| %>
  <% if @artist.errors.any? %>
    <div class="form-errors" role="alert">
      No se pudo guardar:
      <ul><% @artist.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :name, "Nombre" %>
    <%= f.text_field :name, required: true %>
  </div>

  <div class="field">
    <%= f.label :bio, "Reseña" %>
    <p class="hint">Un par de líneas: de dónde son, en qué época, quiénes la integran. Se muestra en el sitio.</p>
    <%= f.text_area :bio, rows: 5, maxlength: 1000 %>
  </div>

  <% if @artist.persisted? %>
    <div class="field" style="max-width: 240px;">
      <%= f.label :status, "Estado" %>
      <%= f.select :status, [ [ "Pendiente", "pending" ], [ "Aprobado", "approved" ] ] %>
    </div>
  <% end %>

  <div class="form-actions">
    <%= f.submit @artist.new_record? ? "Crear artista" : "Guardar cambios", class: "btn-primary" %>
    <%= link_to "Cancelar", admin_artists_path, class: "btn-link" %>
  </div>
<% end %>
