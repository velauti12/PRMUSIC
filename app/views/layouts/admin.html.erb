<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= content_for?(:title) ? "#{yield(:title)} | PRMUSIC admin" : "PRMUSIC admin" %></title>
  <%= csrf_meta_tags %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,300..800&family=Courier+Prime:wght@400;700&display=swap" rel="stylesheet">
  <%= stylesheet_link_tag "admin" %>
</head>
<body>
  <div class="admin">
    <aside class="sidebar">
      <%= link_to admin_root_path, class: "brand" do %>
        <span class="brand-name">PRMUSIC</span>
        <span class="brand-sub">Back-office</span>
      <% end %>

      <nav class="side-nav" aria-label="Secciones">
        <% pending = Song.pending.count %>
        <%= link_to "Inicio", admin_root_path, class: ("active" if controller_name == "dashboard") %>
        <%= link_to admin_songs_path, class: ("active" if controller_name == "songs") do %>
          Canciones
          <% if pending.positive? %><span class="nav-count" title="Pendientes de revisar"><%= pending %></span><% end %>
        <% end %>
        <% pending_artists = Artist.pending.count %>
        <%= link_to admin_artists_path, class: ("active" if controller_name == "artists") do %>
          Artistas
          <% if pending_artists.positive? %><span class="nav-count" title="Artistas propuestos sin revisar"><%= pending_artists %></span><% end %>
        <% end %>
        <%= link_to "Álbumes", admin_albums_path, class: ("active" if controller_name == "albums") %>
        <%= link_to "Géneros", admin_genres_path, class: ("active" if controller_name == "genres") %>
        <%= link_to "Usuarios", admin_users_path, class: ("active" if controller_name == "users") %>
      </nav>

      <div class="sidebar-foot">
        <%= link_to "Ir al sitio", front_url, target: "_blank", rel: "noopener" %>
      </div>
    </aside>

    <main class="content">
      <% if notice %><p class="flash flash-notice" role="status"><%= notice %></p><% end %>
      <% if alert %><p class="flash flash-alert" role="alert"><%= alert %></p><% end %>

      <%= yield %>
    </main>
  </div>
</body>
</html>
