<% content_for :title, @song.title %>

<%= link_to "Canciones", admin_songs_path, class: "back-link" %>

<header class="page-head">
  <div>
    <h1><%= @song.title %></h1>
    <p><%= @song.artist.name %><% if @song.album %>, del disco <em><%= @song.album.title %></em><% end %></p>
  </div>
  <div class="page-actions">
    <%= link_to "Editar", edit_admin_song_path(@song), class: "btn" %>
  </div>
</header>

<div class="song-layout">
  <section aria-label="Cifra">
    <div class="sheet-tools">
      <div class="tool">
        Tono
        <span class="stepper">
          <%= link_to "−", admin_song_path(@song, tono: @semitones - 1), "aria-label": "Bajar medio tono" if @semitones > -11 %>
          <output><%= @key %></output>
          <%= link_to "+", admin_song_path(@song, tono: @semitones + 1), "aria-label": "Subir medio tono" if @semitones < 11 %>
        </span>
        <% unless @semitones.zero? %>
          <%= link_to "Volver a #{@song.original_key}", admin_song_path(@song), class: "btn-link" %>
        <% end %>
      </div>
      <div class="tool">
        Letra
        <span class="stepper">
          <button type="button" onclick="cambiarLetra(-2)" aria-label="Achicar letra">−</button>
          <output id="font-size">15</output>
          <button type="button" onclick="cambiarLetra(2)" aria-label="Agrandar letra">+</button>
        </span>
      </div>
    </div>

    <%= chord_sheet(@content) %>
  </section>

  <aside>
    <dl class="facts">
      <% if @song.album&.cover&.attached? %>
        <%= image_tag @song.album.cover, alt: "Portada de #{@song.album.title}" %>
      <% end %>
      <div><dt>Estado</dt><dd><%= status_tag(@song) %></dd></div>
      <div><dt>Tono original</dt><dd class="key"><%= @song.original_key %></dd></div>
      <div><dt>Género</dt><dd><%= @song.genre&.name || "-" %></dd></div>
      <div><dt>Subida por</dt><dd><%= @song.user ? link_to(@song.user.username, admin_user_path(@song.user)) : "-" %></dd></div>
      <div><dt>Fecha</dt><dd><%= @song.created_at.strftime("%d/%m/%Y") %></dd></div>
    </dl>

    <% if @song.youtube_id %>
      <div class="video">
        <iframe src="https://www.youtube-nocookie.com/embed/<%= @song.youtube_id %>"
                title="Video de <%= @song.title %>" loading="lazy" allowfullscreen
                allow="accelerometer; encrypted-media; picture-in-picture"></iframe>
      </div>
    <% end %>

    <div class="moderation">
      <% if @song.pending? %>
        <p>Revisá que los acordes estén bien ubicados antes de publicarla.</p>
      <% end %>
      <% if @song.artist.pending? %>
        <p>
          El artista es nuevo, lo propuso quien subió la canción. Al aprobarla se aprueba también.
          <%= link_to "Revisar artista", edit_admin_artist_path(@song.artist) %>
        </p>
      <% end %>
      <% unless @song.approved? %>
        <%= button_to "Aprobar y publicar", approve_admin_song_path(@song), method: :patch, class: "btn-approve" %>
      <% end %>
      <% unless @song.rejected? %>
        <%= button_to @song.approved? ? "Despublicar (rechazar)" : "Rechazar", reject_admin_song_path(@song), method: :patch, class: "btn-danger" %>
      <% end %>
      <%= delete_button admin_song_path(@song), confirm: "¿Borrar \"#{@song.title}\"? No se puede deshacer.", label: "Borrar canción" %>
    </div>
  </aside>
</div>

<script>
  let tamanio = 15;
  function cambiarLetra(delta) {
    tamanio = Math.max(12, Math.min(26, tamanio + delta));
    document.getElementById('sheet').style.fontSize = tamanio + 'px';
    document.getElementById('font-size').textContent = tamanio;
  }
</script>
