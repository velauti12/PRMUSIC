<% content_for :title, "Usuarios" %>

<header class="page-head">
  <div>
    <h1>Usuarios</h1>
    <p>Las cuentas se crean desde el sitio. Acá podés ver qué aportó cada uno.</p>
  </div>
</header>

<div class="table-wrap">
  <table class="ruled">
    <thead><tr><th>Usuario</th><th>Email</th><th>Rol</th><th>Canciones</th><th>Alta</th></tr></thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td class="title"><%= link_to user.username, admin_user_path(user) %></td>
          <td class="muted"><%= user.email %></td>
          <td><% if user.admin? %><span class="role-admin">admin</span><% else %><span class="muted">usuario</span><% end %></td>
          <td class="num"><%= user.songs_count %></td>
          <td class="muted"><%= user.created_at.strftime("%d/%m/%Y") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
