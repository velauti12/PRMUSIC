<%= form_with model: [:admin, @song], local: true, class: "form" do |f| %>
  <% if @song.errors.any? %>
    <div class="form-errors" role="alert">
      No se pudo guardar:
      <ul>
        <% @song.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= f.label :title, "Título" %>
    <%= f.text_field :title, required: true %>
  </div>

  <div class="row">
    <div class="field">
      <%= f.label :artist_id, "Artista" %>
      <%= f.collection_select :artist_id, @artists, :id, :name, { prompt: "Elegí un artista" }, required: true %>
    </div>
    <div class="field">
      <%= f.label :album_id, "Álbum" %>
      <%= f.select :album_id,
                   @albums.map { |a| [ "#{a.title} (#{a.artist.name})", a.id ] },
                   { include_blank: "Sin álbum" } %>
    </div>
  </div>

  <div class="row">
    <div class="field">
      <%= f.label :genre_id, "Género" %>
      <%= f.collection_select :genre_id, @genres, :id, :name, { prompt: "Elegí un género" }, required: true %>
    </div>
    <div class="field">
      <%= f.label :original_key, "Tono original" %>
      <%= f.text_field :original_key, placeholder: "Ej: Am", required: true, maxlength: 5 %>
    </div>
    <div class="field">
      <%= f.label :status, "Estado" %>
      <%= f.select :status, status_options %>
    </div>
  </div>

  <div class="field">
    <%= f.label :content, "Letra con acordes" %>
    <p class="hint">Los acordes van en su propia línea, arriba de la sílaba donde cambian, y con mayúscula (Am, G, F#m7).</p>
    <%= f.text_area :content, rows: 18, class: "mono", required: true %>
  </div>

  <div class="form-actions">
    <%= f.submit @song.new_record? ? "Crear canción" : "Guardar cambios", class: "btn-primary" %>
    <%= link_to "Cancelar", @song.persisted? ? admin_song_path(@song) : admin_songs_path, class: "btn-link" %>
  </div>
<% end %>
