<% content_for :title, "Canciones" %>

<header class="page-head">
  <div>
    <h1>Canciones</h1>
    <p>Las pendientes aparecen primero. Aprobalas o rechazalas desde acá o desde la cifra.</p>
  </div>
  <div class="page-actions">
    <%= link_to "Nueva canción", new_admin_song_path, class: "btn-primary" %>
  </div>
</header>

<nav class="tabs" aria-label="Filtrar por estado">
  <%= link_to "Todas (#{@status_counts.values.sum})", admin_songs_path(q: params[:q], genre_id: params[:genre_id]),
              class: ("active" if @status.nil?) %>
  <% Song.statuses.each_key do |status| %>
    <%= link_to "#{status_plural(status)} (#{@status_counts[status] || 0})",
                admin_songs_path(status: status, q: params[:q], genre_id: params[:genre_id]),
                class: ("active" if @status == status) %>
  <% end %>
</nav>

<%= form_with url: admin_songs_path, method: :get, local: true, class: "filters" do |f| %>
  <%= hidden_field_tag :status, @status if @status %>
  <div class="field grow">
    <%= f.label :q, "Buscar" %>
    <%= f.search_field :q, value: params[:q], placeholder: "Título o artista" %>
  </div>
  <div class="field">
    <%= f.label :genre_id, "Género" %>
    <%= f.select :genre_id, options_from_collection_for_select(@genres, :id, :name, params[:genre_id]), include_blank: "Todos" %>
  </div>
  <%= f.submit "Buscar", class: "btn", name: nil %>
  <% if params[:q].present? || params[:genre_id].present? %>
    <%= link_to "Limpiar", admin_songs_path(status: @status), class: "btn-link" %>
  <% end %>
<% end %>

<% if @songs.empty? %>
  <p class="empty">No hay canciones con esos filtros.</p>
<% else %>
  <div class="table-wrap">
    <table class="ruled">
      <thead>
        <tr>
          <th>Canción</th><th>Artista</th><th>Tono</th><th>Subida por</th><th>Estado</th><th><span class="sr-only">Acciones</span></th>
        </tr>
      </thead>
      <tbody>
        <% @songs.each do |song| %>
          <tr>
            <td class="title">
              <%= link_to song.title, admin_song_path(song) %>
              <% if song.album %><div class="muted small"><%= song.album.title %></div><% end %>
            </td>
            <td>
              <%= song.artist.name %>
              <div class="muted small"><%= song.genre&.name %></div>
            </td>
            <td class="key"><%= song.original_key %></td>
            <td class="muted"><%= song.user&.username || "-" %></td>
            <td><%= status_tag(song) %></td>
            <td>
              <div class="actions">
                <% unless song.approved? %>
                  <%= button_to "Aprobar", approve_admin_song_path(song), method: :patch, class: "btn-approve btn-sm" %>
                <% end %>
                <% if song.pending? %>
                  <%= button_to "Rechazar", reject_admin_song_path(song), method: :patch, class: "btn-danger btn-sm" %>
                <% end %>
                <%= link_to "Editar", edit_admin_song_path(song), class: "btn-link" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
