<%= form_with model: [:admin, @genre], local: true, class: "form" do |f| %>
  <% if @genre.errors.any? %>
    <div class="form-errors" role="alert">
      No se pudo guardar:
      <ul><% @genre.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>

  <div class="field" style="max-width: 420px;">
    <%= f.label :name, "Nombre" %>
    <%= f.text_field :name, required: true %>
  </div>

  <div class="form-actions">
    <%= f.submit @genre.new_record? ? "Crear género" : "Guardar cambios", class: "btn-primary" %>
    <%= link_to "Cancelar", admin_genres_path, class: "btn-link" %>
  </div>
<% end %>
