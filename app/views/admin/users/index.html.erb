<% content_for :page_title, "Comunidad y Usuarios" %>

<div class="section-heading">
  <h2 class="section-title"> Usuarios Registrados</h2>
</div>

<div class="table-card" style="max-width: 800px;">
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Nombre de Usuario</th>
          <th>Email</th>
          <th>Rol</th>
          <th>Cifras Aportadas</th>
        </tr>
      </thead>
      <tbody>
        <% @users.each do |user| %>
          <tr>
            <td>#<%= user.id %></td>
            <td><strong style="color: #fff;"><%= user.username %></strong></td>
            <td style="color: var(--text-dim);"><%= user.email %></td>
            <td>
              <span class="badge-admin" style="<%= 'background: rgba(6,182,212,0.15); color: #06b6d4; border-color: rgba(6,182,212,0.3);' unless user.admin? %>">
                <%= user.role %>
              </span>
            </td>
            <td><span class="tag-genre"><%= user.songs.count %> canciones</span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
