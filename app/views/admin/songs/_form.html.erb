<%= form_with model: [:admin, @song], local: true do |f| %>
  <% if @song.errors.any? %>
    <div class="alert alert-danger">
      <div>
        <strong><%= pluralize(@song.errors.count, "error") %> impidieron guardar la canción:</strong>
        <ul style="margin-top: 6px; padding-left: 20px;">
          <% @song.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <div class="form-card">

    <div class="form-section-title">📝 Datos de la Canción</div>

    <div class="form-group">
      <%= f.label :title, "Título de la Canción", class: "form-label" %>
      <%= f.text_field :title, placeholder: "Ej: Muchacha Ojos de Papel", class: "form-control", required: true %>
    </div>

    <div class="form-row-2">
      <div class="form-group">
        <%= f.label :album_id, "Álbum", class: "form-label" %>
        <%= f.collection_select :album_id, @albums, :id, :title,
            { prompt: "Selecciona un álbum (opcional)" },
            { class: "form-control" } %>
      </div>

      <div class="form-group">
        <%= f.label :original_key, "Tono Original", class: "form-label" %>
        <%= f.text_field :original_key, placeholder: "Ej: G, Am, C, D", class: "form-control", required: true %>
      </div>
    </div>

    <div class="form-section-title" style="margin-top: 24px;"> Artista y Clasificación</div>

    <div class="form-row-2">
      <div class="form-group">
        <%= f.label :artist_id, "Artista / Banda", class: "form-label" %>
        <%= f.collection_select :artist_id, @artists, :id, :name,
            { prompt: "Selecciona un artista" },
            { class: "form-control", required: true } %>
      </div>

      <div class="form-group">
        <%= f.label :genre_id, "Género Musical", class: "form-label" %>
        <%= f.collection_select :genre_id, @genres, :id, :name,
            { prompt: "Selecciona un género" },
            { class: "form-control" } %>
      </div>
    </div>

    <div class="form-row-2" style="margin-top: 16px;">
      <div class="form-group">
        <%= f.label :status, "Estado de Moderación", class: "form-label" %>
        <%= f.select :status, Song.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "form-control" %>
      </div>
    </div>

    <div class="form-section-title" style="margin-top: 24px;">🎼 Cifra / Letra y Acordes</div>

    <div class="form-group">
      <div style="font-size: 12px; color: var(--text-dim); margin-bottom: 8px; line-height: 1.5;">
        Usá formato monoespaciado: colocá los acordes justo arriba de las sílabas que corresponden, separados con espacios.
      </div>
      <%= f.text_area :content, rows: 18, class: "form-control form-control-mono",
          placeholder: "[INTRO] G - D - Em - C\n\n       G           D\nMuchacha ojos de papel...", required: true %>
    </div>

    <div class="form-actions">
      <%= f.submit @song.new_record? ? "Publicar Canción" : "Guardar Cambios", class: "btn-accent" %>
      <%= link_to "Cancelar", admin_songs_path, class: "btn-sm btn-secondary", style: "padding: 11px 20px; font-size: 14px;" %>
    </div>
  </div>
<% end %>
